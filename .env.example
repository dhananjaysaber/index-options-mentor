# LOCAL DEVELOPMENT ONLY. Never commit a real .env file.
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_SESSION_SECRET=
FYERS_REDIRECT_URI=http://127.0.0.1:8787/api/fyers/callback

# Permanent Google Sheets trade journal. Keep the real values in hosted environment variables.
JOURNAL_WEB_APP_URL=
JOURNAL_SHARED_SECRET=

# Secure trading server — Phase 1 safe defaults.
# LIVE order placement is not implemented in this phase.
EXECUTION_MODE=SIMULATION
TRADING_BRIDGE_ENABLED=false
LIVE_TRADING_ENABLED=false

# Independent server-side risk limits.
# Leave blank until intentionally configuring PAPER testing.
TRADING_CAPITAL_RS=
MAX_RISK_PER_TRADE_RS=
MAX_LOTS=
DAILY_LOSS_LIMIT_RS=
MAX_QUOTE_AGE_MS=3000
ONE_POSITION_AT_A_TIME=true
ALLOWED_ORDER_SYMBOL_PREFIXES=NSE:NIFTY

# Runtime/audit data stays outside Git.
TRADING_DATA_DIR=.runtime/trading

# Reserved for Phase 2 encrypted broker-token storage.
FYERS_TOKEN_ENCRYPTION_KEY=
