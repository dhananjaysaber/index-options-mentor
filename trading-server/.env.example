# Network
PORT=8788
HOST=127.0.0.1
ALLOWED_ORIGINS=https://dhananjaysaber.github.io

# Control API authentication.
# Generate locally/on the server. Never commit the real value.
CONTROL_API_KEY=

# Execution starts in simulation. LIVE is not implemented in phase 1.
EXECUTION_MODE=SIMULATION

# Independent server-side risk limits. Zero/unset values fail closed.
CAPITAL_LIMIT=0
MAX_RISK_PER_TRADE_PCT=0
MAX_LOTS=0
DAILY_LOSS_LIMIT=0
STALE_DATA_MS=5000
ONE_POSITION_AT_A_TIME=true
GLOBAL_KILL_SWITCH=false

# Persistent server data directory.
DATA_DIR=./data

# FYERS credentials: configure only in the hosting provider/server environment.
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=
FYERS_FRONTEND_RETURN_URL=https://dhananjaysaber.github.io/index-options-mentor-pwa/

# 32 random bytes, base64 encoded. Example:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Long random value used to sign OAuth state.
STATE_SIGNING_SECRET=
